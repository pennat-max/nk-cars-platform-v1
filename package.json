{
  "name": "nk-cars-platform-v1",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/marketplace-connector.test.mjs tests/buying-browser.test.mjs tests/native-browser-contract.test.mjs tests/qnap-migration.test.mjs tests/sourcing-automation-service.test.mjs",
    "test:connector-browser": "node marketplace-connector/browser-fixture-smoke.mjs",
    "connector:token": "node marketplace-connector/token.mjs",
    "connector:login": "node marketplace-connector/login.mjs",
    "connector:start": "node marketplace-connector/server.mjs",
    "connector:qnap-worker": "node marketplace-connector/qnap-worker.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "qnap:seed": "node scripts/build-qnap-migration-seed.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.33.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "playwright-core": "1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "NK Cars Platform V1"
}

# NK Cars environment template
# Copy to the appropriate local environment file and fill values from authorized secret sources.
# NEVER commit real secrets, tokens, passwords, cookies, or private keys.

# App
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# Supabase / database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=

# Deployment / runtime (only if used)
VERCEL_URL=

# External/source integrations (only when a real approved integration is activated)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=

# Notes
# - Browser session cookies/profiles are local/managed session data and must NOT be stored here.
# - Add any newly required variable to this template when the application introduces it.
